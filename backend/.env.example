# Backend Configuration
# ================================================================================
BACKEND_PORT=3000
DATABASE_URL="postgres://user:password@localhost:5432/subflow"
# Frontend URL - adjust to your frontend. Enhanced auth examples use localhost:5173 for dev.
FRONTEND_URL="https://example.com"

# Security Configuration
# ================================================================================
# Generate secure keys using: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_here
# Generate secure pepper using: openssl rand -base64 64
AUTH_SECRET=your_auth_pepper_secret_here

# Email Service Configuration
# ================================================================================
ENABLE_EMAIL_SERVICE=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_password
SMTP_SECURE=false
SMTP_FROM="SubFlow <no-reply@example.com>"

# ==================== Authentication Configuration ====================

# -------------------- WebAuthn / PassKey --------------------
# For production, use your actual domain
WEBAUTHN_RP_NAME="SubFlow"
WEBAUTHN_RP_ID="localhost"  # Change to your domain in production (e.g., "example.com")
WEBAUTHN_ORIGIN="http://localhost:5173"  # Change to your frontend URL

# -------------------- LDAP Configuration --------------------
# Active Directory / LDAP Authentication
LDAP_URL="ldap://your-ldap-server.com:389"
# Use ldaps:// for secure connection: ldaps://your-ldap-server.com:636

# Base DN for search
LDAP_BASE_DN="dc=example,dc=com"

# Bind DN (service account with read permissions)
LDAP_BIND_DN="cn=admin,dc=example,dc=com"
LDAP_BIND_PASSWORD="your-ldap-password"

# User search filter (customize based on your LDAP schema)
LDAP_USER_SEARCH_FILTER="(uid={{username}})"
# For Active Directory, use: (sAMAccountName={{username}})
# For email-based login: (mail={{username}})

# -------------------- SSO / OAuth2 Providers --------------------

# Google OAuth2
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/auth/sso/callback/google"

# GitHub OAuth2
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
GITHUB_REDIRECT_URI="http://localhost:3000/auth/sso/callback/github"

# Microsoft / Azure AD
MICROSOFT_CLIENT_ID="your-microsoft-client-id"
MICROSOFT_CLIENT_SECRET="your-microsoft-client-secret"
MICROSOFT_TENANT_ID="common"  # Or your specific tenant ID
MICROSOFT_REDIRECT_URI="http://localhost:3000/auth/sso/callback/microsoft"

# Generic OIDC Provider (e.g., Keycloak, Auth0)
OIDC_ISSUER="https://your-oidc-provider.com"
OIDC_CLIENT_ID="your-client-id"
OIDC_CLIENT_SECRET="your-client-secret"
OIDC_REDIRECT_URI="http://localhost:3000/auth/sso/callback/oidc"

# -------------------- Device Security --------------------
# AES encryption key for device tokens (32 bytes hex)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEVICE_TOKEN_ENCRYPTION_KEY="your-32-byte-hex-encryption-key-here-64-chars"

# Device token cookie settings
DEVICE_TOKEN_COOKIE_MAX_AGE="31536000000"  # 1 year in milliseconds
DEVICE_TOKEN_COOKIE_DOMAIN=""  # Leave empty for current domain, or set to ".example.com"

# Risk-based authentication thresholds
RISK_SCORE_2FA_THRESHOLD="40"  # Require 2FA if risk score >= this value
RISK_SCORE_BLOCK_THRESHOLD="80"  # Block login if risk score >= this value

# -------------------- Email Notifications --------------------
# Device notification preferences (set defaults)
DEFAULT_NOTIFY_NEW_DEVICE="true"
DEFAULT_NOTIFY_NEW_LOCATION="true"
DEFAULT_NOTIFY_SUSPICIOUS_ACTIVITY="true"

# -------------------- Frontend URL --------------------
# Used for redirects and email links. Override FRONTEND_URL above if different.
FRONTEND_URL_ENHANCED="http://localhost:5173"

# -------------------- Production Notes --------------------
# 1. Change all localhost URLs to your production domains
# 2. Use HTTPS for all URLs in production
# 3. Generate strong random keys for encryption
# 4. Store secrets securely (e.g., AWS Secrets Manager, HashiCorp Vault)
# 5. Configure OAuth redirect URIs in provider dashboards
# 6. For LDAP, use ldaps:// and verify SSL certificates
# 7. Set appropriate CORS origins in your backend configuration

# -------------------- Quick Tips --------------------
# - Keep this file checked into source control as a SAMPLE only. Do NOT commit real secrets.
# - Create a runtime .env from this sample and populate with actual secrets before deployment.
