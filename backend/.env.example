# Backend Configuration
# ================================================================================
BACKEND_PORT=3000
DATABASE_URL="postgres://user:password@localhost:5432/subflow"
FRONTEND_URL="https://example.com"

# Security Configuration
# ================================================================================
# Generate secure keys using: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_here
# Generate secure pepper using: openssl rand -base64 64
AUTH_SECRET=your_auth_pepper_secret_here
# 5 failed attempts
AUTH_MAX_FAILED_ATTEMPTS=5
# when failed attempts reach max, lockout for 720 minutes
AUTH_LOCKOUT_DURATION_MINS=720

# Rate Limit Configuration
# ================================================================================
# Auth Rate Limit
AUTH_RATE_LIMIT_WINDOW_MS=15 * 60 * 1000
AUTH_RATE_LIMIT_MAX=5
# API Rate Limit
API_RATE_LIMIT_WINDOW_MS=15 * 60 * 1000
API_RATE_LIMIT_MAX=100

# Email Service Configuration
# ================================================================================
ENABLE_EMAIL_SERVICE=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_password
SMTP_SECURE=false
SMTP_FROM="SubFlow <no-reply@example.com>"
