{
    "name": "frontend",
    "private": true,
    "version": "0.2.0-alpha.4",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc -b && vite build",
        "test": "vitest run",
    "codeql": "node ../scripts/codeql-local.mjs",
    "test:ci": "npm run test && npm run codeql",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:report": "playwright show-report",
        "lint": "eslint .",
        "preview": "vite preview",
        "start": "vite preview --host"
    },
    "dependencies": {
        "jszip": "^3.10.2",
        "pdfjs-dist": "^6.3.289",
        "pinia": "^3.0.4",
        "pocketbase": "^0.27.0",
        "vue": "^3.5.44",
        "vue-router": "^4.6.4"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@types/node": "^25.6.0",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vitest/coverage-v8": "^4.1.12",
        "@vue/test-utils": "^2.4.11",
        "@vue/tsconfig": "^0.9.1",
        "eslint": "^9.17.0",
        "eslint-plugin-vue": "^10.11.1",
        "jsdom": "^30.0.1",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.19.0",
        "vite": "^8.0.11",
        "vite-plugin-pwa": "^1.3.0",
        "vitest": "^4.1.12",
        "vue-eslint-parser": "^10.4.1",
        "vue-tsc": "^3.3.8"
    }
}
