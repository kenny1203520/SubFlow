SUBFLOW_IMAGE=subflow:local
SUBFLOW_HTTP_PORT=8080
SUBFLOW_PUBLISH_PORT=8080
SUBFLOW_DATA_DRIVER=pocketbase
SUBFLOW_ENV=development
SUBFLOW_APP_URL=http://localhost:8080

# 僅供本機 Vite development server 使用
VITE_BACKEND_URL=http://localhost:8080

# 正式環境寄送邀請與密碼重設信件時必填
SUBFLOW_SMTP_HOST=
SUBFLOW_SMTP_PORT=587
SUBFLOW_SMTP_USER=
SUBFLOW_SMTP_PASSWORD=
SUBFLOW_SMTP_FROM=
