SUBFLOW_IMAGE=subflow:local
SUBFLOW_HTTP_PORT=8080 # HTTPS listener port (name retained for compatibility)
SUBFLOW_ENV=production

# Root key for encrypted PocketBase settings and purpose-separated audit/share signatures.
# Generate a random value once, store it in your deployment secret store, and preserve it with backups.
SUBFLOW_SETTINGS_ENCRYPTION_KEY=

# SMTP and the public Application URL are configured in PocketBase Admin.
